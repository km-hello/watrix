# Replace YOUR_METER_ID with your numeric meter ID before starting.
# This deliberately invalid placeholder prevents accidental collection.
WATRIK_METER_URL=https://www.wap.cnyiot.com/nat/pay.aspx?mid=YOUR_METER_ID
WATRIK_TIMEZONE=Asia/Shanghai
# Optional. Keep the real token only in the untracked .env file.
WATRIK_TELEGRAM_BOT_TOKEN=

# The Docker image defaults match the server Compose data mount:
# WATRIK_ADDR=:8080
# WATRIK_DATABASE_PATH=/app/data/watrik.db
# WATRIK_STATIC_DIR=/app/dist
